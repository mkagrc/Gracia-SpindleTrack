# Copy to .env and replace values locally. Never commit .env or service-account JSON.
SERVER_PORT=8080
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/path/firebase-service-account.json
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-ID-default-rtdb.REGION.firebasedatabase.app
ADMIN_EMAIL=platform-admin@example.com
FILE_STORAGE_PATH=C:/Users/yourname/AppData/Local/SpindleTrack/private-documents
