# Copy to .env and replace values locally. Never commit .env or service-account JSON.
DB_URL=jdbc:mysql://localhost:3307/spindletrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Manila
DB_USERNAME=spindletrack
DB_PASSWORD=replace-with-your-local-password
SERVER_PORT=8080
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/path/firebase-service-account.json
ADMIN_EMAIL=platform-admin@example.com
