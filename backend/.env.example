# Copy to .env and replace values locally. Never commit .env or service-account JSON.
SERVER_PORT=8080
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/path/firebase-service-account.json
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-ID-default-rtdb.REGION.firebasedatabase.app
ADMIN_EMAIL=platform-admin@example.com
FILE_STORAGE_PATH=C:/Users/yourname/AppData/Local/SpindleTrack/private-documents
PAYPAL_CLIENT_ID=replace-with-sandbox-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/paypal/cancel

# Brevo transactional email (server-side only)
BREVO_API_KEY=replace-with-server-side-brevo-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=SpindleTrack
NEARBY_RADIUS_KM=15.0
NOMINATIM_USER_AGENT=SpindleTrack/1.0 (contact: admin@spindletrack.app)
